<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:Snap.Net.Avalonia.Behaviors"
        xmlns:viewModels="clr-namespace:Snap.Net.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Snap.Net.Avalonia.Views.PlayerWindow"
        x:DataType="viewModels:PlayerWindowViewModel"
        Icon="/Assets/snapcast.ico"
        Title="Players"
        CanResize="False"
        Background="{DynamicResource BackgroundBrush}"
        SizeToContent="WidthAndHeight">

    <Design.DataContext>
        <viewModels:PlayerWindowViewModel />
    </Design.DataContext>

    
    <StackPanel Margin="10" MinWidth="420">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0"
                       Text="Available audio devices"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"/>
            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Width="32" Height="32"
                    Padding="0">
                <Path Fill="Gray" Width="14" Height="14"
                      Stretch="Uniform"
                      Data="{StaticResource RefreshRegular}"/>
            </Button>
        </Grid>

        <!-- Column header -->
        <Grid ColumnDefinitions="44,Auto,*,36,36" Margin="4,0,4,4">
            <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Auto-play"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="Gray"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding PlayerDevices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4,6,4,6"
                            CornerRadius="4"
                            Margin="0,1,0,1">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="44,Auto,*,36,36">

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding AutoPlay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Index}"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding FriendlyName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="{Binding NameFontWeight}"
                                       Foreground="{Binding NameForeground}"/>

                            <ToggleButton Grid.Column="3"
                                          Width="28" Height="28"
                                          Padding="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Command="{Binding TogglePlay}"
                                          IsChecked="{Binding IsPlaying}">
                                <Panel>
                                    <Path IsVisible="{Binding !IsPlaying}"
                                          Fill="Gray"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Data="{StaticResource PlayRegular}"/>
                                    <Path IsVisible="{Binding IsPlaying}"
                                          Fill="Orange"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Data="{StaticResource PauseRegular}"/>
                                </Panel>
                            </ToggleButton>

                            <Button Grid.Column="4"
                                    Width="28" Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout
                                        Placement="LeftEdgeAlignedTop"
                                        FlyoutPresenterClasses="noPadding">
                                        <Border
                                                CornerRadius="4"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SystemAccentColor}"
                                                Padding="12,8,12,8">
                                            <Border.Background>
                                                <SolidColorBrush Color="{DynamicResource SystemAltHighColor}"/>
                                            </Border.Background>
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                                  Width="280" 
                                                  RowSpacing="8" ColumnSpacing="12">

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Latency" VerticalAlignment="Center"/>
                                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Latency}"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Host ID" VerticalAlignment="Center"/>
                                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding HostId}"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Extra args" VerticalAlignment="Center"/>
                                                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding ExtraArgs}"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Auto-restart" VerticalAlignment="Center"/>
                                                <CheckBox  Grid.Row="3" Grid.Column="1" IsChecked="{Binding AutoRestartOnError}"/>

                                                <Button    Grid.Row="4" Grid.Column="1"
                                                           Content="Save"
                                                           Command="{Binding SaveSettingsCommand}"
                                                           HorizontalAlignment="Right">
                                                    <Interaction.Behaviors>
                                                        <EventTriggerBehavior EventName="Click">
                                                            <behaviors:CloseFlyoutAction />
                                                        </EventTriggerBehavior>
                                                    </Interaction.Behaviors>
                                                </Button>
                                                
                                                <Separator Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                           Height="1" Margin="0,4,0,0"/>

                                                <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                        CornerRadius="4" Padding="8,6">
                                                    <SelectableTextBlock Text="{Binding PlayerCommandPreview}"
                                                                         FontFamily="Monospace"
                                                                         FontSize="11"
                                                                         TextWrapping="Wrap"
                                                                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                </Border>

                                            </Grid>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                                <Path Fill="Gray"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Data="{StaticResource SettingsRegular}"/>
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</Window>
