<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Snap.Net.Avalonia.Views"
        xmlns:viewModels="clr-namespace:Snap.Net.Avalonia.ViewModels.ControlClient"
        xmlns:viewModels1="clr-namespace:Snap.Net.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Snap.Net.Avalonia.Views.PlayerWindow"
        x:DataType="viewModels1:PlayerWindowViewModel"
        Icon="/Assets/snapcast.ico"
        Title="Settings"
        CanResize="False"
        SizeToContent="WidthAndHeight">

    <Design.DataContext>
        <viewModels1:PlayerWindowViewModel />
    </Design.DataContext>
    <StackPanel Margin="10" MinWidth="420">

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0"
                       Text="Available audio devices"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"/>
            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Width="32" Height="32"
                    Padding="0">
                <Path Fill="Gray" Width="14" Height="14"
                      Stretch="Uniform"
                      Data="{StaticResource RefreshRegular}"/>
            </Button>
        </Grid>

        <!-- Column header -->
        <Grid ColumnDefinitions="44,Auto,*,36,36" Margin="4,0,4,4">
            <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Auto-play"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="Gray"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding PlayerDevices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4,6,4,6"
                            CornerRadius="4"
                            Margin="0,1,0,1">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="44,Auto,*,36,36">

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding AutoPlay}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Index}"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontSize="12"
                                       Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding FriendlyName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="{Binding NameFontWeight}"
                                       Foreground="{Binding NameForeground}"/>

                            <ToggleButton Grid.Column="3"
                                          Width="28" Height="28"
                                          Padding="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          IsChecked="{Binding IsPlaying}">
                                <Panel>
                                    <Path IsVisible="{Binding !IsPlaying}"
                                          Fill="Gray"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Data="{StaticResource PlayRegular}"/>
                                    <Path IsVisible="{Binding IsPlaying}"
                                          Fill="Orange"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Data="{StaticResource PauseRegular}"/>
                                </Panel>
                            </ToggleButton>

                            <Button Grid.Column="4"
                                    Width="28" Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Command="{Binding OpenSettingsCommand}">
                                <Path Fill="Gray"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Data="{StaticResource SettingsRegular}"/>
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</Window>
